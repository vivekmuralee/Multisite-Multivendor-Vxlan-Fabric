    {
      "id": 16,
      "type": "timeseries",
      "title": "Vxlan1 throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "VTEP interface bits/s; empty if EOS does not stream counters for Vxlan1 over OpenConfig.",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(gnmi_interfaces_interface_state_counters_in_octets{source=~\"$switch\",interface_name=\"Vxlan1\"}[2m]) * 8",
          "legendFormat": "{{source}} in",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(gnmi_interfaces_interface_state_counters_out_octets{source=~\"$switch\",interface_name=\"Vxlan1\"}[2m]) * 8",
          "legendFormat": "{{source}} out",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
