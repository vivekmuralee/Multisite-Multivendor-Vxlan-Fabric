    {
      "id": 9,
      "type": "table",
      "title": "L2 VNI status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "VLAN-to-VNI bindings on Vxlan1 (eAPI show vxlan vni). A missing row means the VNI is not bound on that VTEP. Binding: static or evpn-learned.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (source, vni, vlan, binding) (eos_vni_l2_info{source=~\"$switch\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "source": "Switch",
              "vni": "L2 VNI",
              "vlan": "VLAN",
              "binding": "Binding",
              "Value": "Status"
            },
            "indexByName": {
              "source": 0,
              "vlan": 1,
              "vni": 2,
              "binding": 3,
              "Value": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Switch"
              },
              {
                "field": "VLAN"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Bound",
                        "color": "green",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
