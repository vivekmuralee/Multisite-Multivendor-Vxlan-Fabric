    {
      "id": 12,
      "type": "timeseries",
      "title": "EVPN prefixes received",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "EVPN routes (type-2/3/5) received per overlay peer.",
      "gridPos": {
        "x": 12,
        "y": 15,
