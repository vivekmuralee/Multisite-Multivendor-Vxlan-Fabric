    {
      "id": 6,
      "type": "stat",
      "title": "EVPN sessions up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Established overlay (EVPN) BGP sessions to the spine loopbacks.",
