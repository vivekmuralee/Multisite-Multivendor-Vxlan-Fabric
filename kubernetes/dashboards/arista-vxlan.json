    },
    {
      "id": 14,
      "type": "table",
      "title": "Interface IP addresses",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every IPv4 address configured on every switch (gNMI openconfig-if-ip): loopbacks (router-id / VTEP), SVIs, routed uplinks and management.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (source, interface_name, address_ip) (gnmi_interfaces_interface_subinterfaces_subinterface_ipv4_addresses_address_state_prefix_length{source=~\"$switch\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (source, interface_name, address_ip) (gnmi_interfaces_interface_subinterfaces_subinterface_ipv4_addresses_address_state_prefix_length{source=~\"$switch\"}) * 0 + on (source, interface_name) group_left () (max by (source, interface_name) (gnmi_interfaces_interface_state_oper_status{source=~\"$switch\",oper_status=\"UP\"}) or (max by (source, interface_name) (gnmi_interfaces_interface_state_oper_status{source=~\"$switch\",oper_status!=\"UP\"}) * 0))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "source": "Switch",
              "interface_name": "Interface",
              "address_ip": "IPv4 address",
              "Value #A": "Prefix length",
              "Value #B": "State"
            },
            "indexByName": {
              "source": 0,
              "interface_name": 1,
              "address_ip": 2,
              "Value #A": 3,
              "Value #B": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Switch"
              },
              {
                "field": "Interface"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
