      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(gnmi_interfaces_interface_state_oper_status{source=~\"$switch\",oper_status!=\"UP\",interface_name=~\"Vlan.*|Loopback.*|Vxlan.*\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
