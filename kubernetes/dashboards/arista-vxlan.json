    {
      "id": 7,
      "type": "stat",
      "title": "Down IP interfaces",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "SVIs, loopbacks and Vxlan interfaces that are not oper UP.",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
