# /etc/netplan/50-cloud-init.yaml on each node (set by hand on the console after cloning).
# Replace IFACE and ADDR per node, then: sudo netplan apply
#   kubemaster-1  enp8s0  192.168.122.91   (e1000e NIC)
#   kubemaster-2  enp1s0  192.168.122.92   (virtio)
#   kubemaster-3  enp1s0  192.168.122.93
#   kubeworker-1  enp1s0  192.168.122.94
#   kubeworker-2  enp1s0  192.168.122.95
#   kubeworker-3  enp1s0  192.168.122.96
network:
  version: 2
  ethernets:
    IFACE:
      dhcp4: no
      addresses:
      - "ADDR/24"
      nameservers:
        addresses:
        - 8.8.8.8
        search:
        - attlocal.net
      routes:
      - to: default
        via: "192.168.122.1"
