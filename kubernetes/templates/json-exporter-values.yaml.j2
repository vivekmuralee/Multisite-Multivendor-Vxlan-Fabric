# prometheus-json-exporter values (rendered by Ansible, tag: bgp)
# One module per VRF: the NVUE API returns {<interface>: {<neighbor fields>}} so the
# object path {.*} walks every BGP peer. The state is exported as a label on a constant 1
# (bgp_peer_info) because the exporter can only turn numbers, not strings, into values;
# sessions up = count(bgp_peer_info{state="established"}).
configuration:
  config: |
    ---
    modules:
{% for m in [{'name': 'bgp_default', 'vrf': 'default'}, {'name': 'bgp_tenant_a', 'vrf': 'TENANT_A'}] %}
      {{ m.name }}:
        http_client_config:
          tls_config:
            insecure_skip_verify: true
          basic_auth:
            username: {{ nvue_api_user }}
            password: {{ nvue_api_password }}
        metrics:
          - name: bgp_peer
            type: object
            help: BGP neighbor (from NVUE REST API)
            path: '{.*}'
            labels:
              vrf: {{ m.vrf }}
              peer: '{.remote-hostname}'
              remote_as: '{.remote-as}'
              router_id: '{.remote-router-id}'
              state: '{.state}'
            values:
              info: 1
              uptime_msec: '{.uptime-msec}'
              connections_dropped: '{.connections-dropped}'
              connections_established: '{.connections-established}'
          - name: bgp_peer_prefixes
            type: object
            help: Prefixes received from the neighbor, per address family
            path: '{.*}'
            labels:
              vrf: {{ m.vrf }}
              peer: '{.remote-hostname}'
              remote_as: '{.remote-as}'
              router_id: '{.remote-router-id}'
              state: '{.state}'
            values:
              ipv4_unicast: '{.address-family.ipv4-unicast.rx-prefix}'
              l2vpn_evpn: '{.address-family.l2vpn-evpn.rx-prefix}'
{% endfor %}
      # Arista eAPI (POST /command-api, JSON-RPC). One call returns [show vxlan vni, show vxlan vtep].
      # json-exporter cannot export map keys as labels, so the known VNIs (group_vars arista_l2_vnis /
      # arista_l3_vnis) are addressed by path with the VNI as a static label; a VNI that disappears from
      # the switch simply stops producing eos_vni_*_info, which the dashboard shows as Down.
      # Paths follow `show vxlan vni | json` on EOS 4.35; validate on a live switch if a panel is empty.
      eos_vxlan:
        method: POST
        headers:
          Content-Type: application/json
        body:
          content: '{"jsonrpc":"2.0","method":"runCmds","id":"1","params":{"version":1,"format":"json","cmds":["show vxlan vni","show vxlan vtep"]}}'
        http_client_config:
          tls_config:
            insecure_skip_verify: true
          basic_auth:
            username: {{ gnmi_user }}
            password: {{ gnmi_password }}
        metrics:
{% for v in arista_l2_vnis %}
          - name: eos_vni_l2
            type: object
            help: L2 VNI bound to a VLAN on Vxlan1
            path: "{.result[0].vxlanIntfs.Vxlan1.vniBindings['{{ v.vni }}']}"
            labels:
              vni: '{{ v.vni }}'
              vlan: '{.vlan}'
              binding: '{.source}'
            values:
              info: 1
{% endfor %}
{% for v in arista_l3_vnis %}
          - name: eos_vni_l3
            type: object
            help: L3 VNI bound to a VRF on Vxlan1
            path: "{.result[0].vxlanIntfs.Vxlan1.vniBindingsToVrf['{{ v.vni }}']}"
            labels:
              vni: '{{ v.vni }}'
              vrf: '{.vrfName}'
              vlan: '{.vlan}'
              binding: '{.source}'
            values:
              info: 1
{% endfor %}
          - name: eos_vtep
            type: object
            help: Remote VTEP learned on Vxlan1
            path: '{.result[1].vteps[*]}'
            labels:
              vtep: '{@}'
            values:
              info: 1

serviceMonitor:
  enabled: true
  namespace: {{ monitoring_namespace }}
  defaults:
    interval: {{ bgp_scrape_interval }}
    scrapeTimeout: {{ bgp_scrape_timeout }}
  targets:
{% for t in bgp_targets %}
    - name: {{ t.name }}
      url: https://{{ t.ip }}:8765/nvue_v1/vrf/default/router/bgp/neighbor
      module: bgp_default
{% if t.tenant_a | default(false) %}
    - name: {{ t.name }}-tenant-a
      url: https://{{ t.ip }}:8765/nvue_v1/vrf/TENANT_A/router/bgp/neighbor
      module: bgp_tenant_a
      additionalMetricsRelabels:
        target: {{ t.name }}
{% endif %}
{% endfor %}
{% for t in arista_eapi_targets %}
    - name: {{ t.name }}-vxlan
      url: https://{{ t.ip }}/command-api
      module: eos_vxlan
      additionalMetricsRelabels:
        source: {{ t.name }}
{% endfor %}
