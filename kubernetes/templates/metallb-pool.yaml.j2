apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: {{ metallb_pool_name }}
  namespace: metallb-system
spec:
  addresses:
{% for a in metallb_addresses %}
    - {{ a }}
{% endfor %}
  autoAssign: true
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: {{ metallb_pool_name }}-l2
  namespace: metallb-system
spec:
  ipAddressPools:
    - {{ metallb_pool_name }}
