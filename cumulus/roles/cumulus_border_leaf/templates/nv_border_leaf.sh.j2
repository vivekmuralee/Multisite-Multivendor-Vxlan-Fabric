#!/bin/bash
# This script is generated by Ansible (cumulus_border_leaf role) - do not edit by hand.
# Turns a leaf into a border gateway. The L2 + L3 EVPN side (spine uplinks,
# VNIs, anycast gateways, tenant VRF / L3 VNI) is already staged by the
# cumulus_underlay and cumulus_overlay roles, since border_leaf is a child
# of the leaf group. This adds the WAN side: a numbered eBGP session to each
# PE router inside the tenant vrf (VRF-lite), route policy, and re-export of
# WAN routes into EVPN as type-5. A separate "nv config apply" task commits this.
set -e

# Tenant subnets (from vni_mappings) - the only prefixes the WAN gets to see.
{% for m in vni_mappings %}
nv set router policy prefix-list TENANT_SUBNETS rule {{ loop.index * 10 }} match {{ m.subnet }}
nv set router policy prefix-list TENANT_SUBNETS rule {{ loop.index * 10 }} action permit
{% endfor %}

# To the PEs: tenant subnets only (implicit deny drops /32 host routes, the
# WAN /30s and routes learned from the other PE - so the fabric never
# becomes a transit path between PE1 and PE2).
nv set router policy route-map WAN_OUT rule 10 match ip-prefix-list TENANT_SUBNETS
nv set router policy route-map WAN_OUT rule 10 action permit

# From the PEs: everything except our own tenant subnets coming back.
nv set router policy route-map WAN_IN rule 10 match ip-prefix-list TENANT_SUBNETS
nv set router policy route-map WAN_IN rule 10 action deny
nv set router policy route-map WAN_IN rule 20 action permit

{% for u in wan_uplinks %}
# {{ u.description }}
nv set interface {{ u.interface }} description "{{ u.description }}"
nv set interface {{ u.interface }} link state up
nv set interface {{ u.interface }} link mtu {{ wan_mtu }}
nv set interface {{ u.interface }} ip address {{ u.local_ip }}
nv set interface {{ u.interface }} ip vrf {{ l3vni.vrf }}

nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} type numbered
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} remote-as {{ wan_pe_routers[u.pe].asn }}
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} description {{ u.pe }}
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} bfd enable on
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} address-family ipv4-unicast enable on
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} address-family ipv4-unicast policy inbound route-map WAN_IN
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} address-family ipv4-unicast policy outbound route-map WAN_OUT

{% endfor %}
# Re-advertise the vrf's ipv4 routes (WAN prefixes from the PEs) into EVPN
# as type-5 with this border leaf's VTEP as next-hop, so every other leaf
# reaches the WAN through the border leafs over the L3 VNI.
nv set vrf {{ l3vni.vrf }} router bgp address-family ipv4-unicast route-export to-evpn enable on

# PE1 and PE2 are in different ASNs, so their AS paths never match - without
# aspath-ignore BGP picks one PE instead of load-sharing across both.
nv set vrf {{ l3vni.vrf }} router bgp path-selection multipath aspath-ignore on
nv set vrf {{ l3vni.vrf }} router bgp address-family ipv4-unicast multipaths ebgp {{ bgp_ecmp }}
