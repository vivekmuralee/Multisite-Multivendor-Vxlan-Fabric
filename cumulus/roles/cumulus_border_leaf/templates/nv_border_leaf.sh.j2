#!/bin/bash
# This script is generated by Ansible (cumulus_border_leaf role) - do not edit by hand.
# Stages the external (WAN/MPLS edge) uplink and its numbered eBGP session
# inside the tenant vrf. A separate "nv config apply" task commits this.
set -e

# {{ external_uplink.description }}
nv set interface {{ external_uplink.interface }} link state up
nv set interface {{ external_uplink.interface }} link mtu {{ fabric_mtu }}
nv set interface {{ external_uplink.interface }} ip address {{ external_uplink.local_ip }}
nv set interface {{ external_uplink.interface }} ip vrf {{ l3vni.vrf }}

# Numbered (not unnumbered - the WAN/MPLS edge is outside the fabric's
# unnumbered underlay domain) eBGP session toward the external edge router.
# Only leak/accept tenant prefixes here - tighten with route-maps/prefix-lists
# before using this in production.
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ external_uplink.peer_ip }} type numbered
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ external_uplink.peer_ip }} remote-as {{ external_bgp.peer_asn }}
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ external_uplink.peer_ip }} address-family ipv4-unicast enable on
