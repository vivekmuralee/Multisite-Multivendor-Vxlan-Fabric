#!/bin/bash
# This script is generated by Ansible (cumulus_border_leaf role) - do not edit by hand.
# Turns a leaf into a border gateway. The L2 + L3 EVPN side (spine uplinks,
# VNIs, anycast gateways, tenant VRF / L3 VNI, vrf ECMP) is already staged by
# the cumulus_underlay and cumulus_overlay roles, since border_leaf is a child
# of the leaf group. This adds the WAN side: a numbered eBGP session to each
# PE router inside the tenant vrf (VRF-lite) that accepts only the default
# route and advertises only the tenant summary, plus re-export of that
# default route into EVPN as type-5. A separate "nv config apply" task commits this.
set -e

# Tenant summary - built from the connected tenant /24s (vlan SVIs exist on
# every border leaf, so it is always present). Not summary-only: the /24s
# must stay unsuppressed for EVPN; WAN_OUT keeps them away from the PEs.
nv set vrf {{ l3vni.vrf }} router bgp address-family ipv4-unicast aggregate-route {{ tenant_summary }}

nv set router policy prefix-list DEFAULT_ROUTE rule 10 match 0.0.0.0/0
nv set router policy prefix-list DEFAULT_ROUTE rule 10 action permit
nv set router policy prefix-list TENANT_SUMMARY rule 10 match {{ tenant_summary }}
nv set router policy prefix-list TENANT_SUMMARY rule 10 action permit

# To the PEs: the tenant summary only. Rule 20 denies everything else
# explicitly (/24s, /32 host routes, WAN /30s, the default route learned from
# the other PE - the fabric never becomes transit between PE1 and PE2).
nv set router policy route-map WAN_OUT rule 10 match ip-prefix-list TENANT_SUMMARY
nv set router policy route-map WAN_OUT rule 10 action permit
nv set router policy route-map WAN_OUT rule 20 action deny

# From the PEs: the default route only.
nv set router policy route-map WAN_IN rule 10 match ip-prefix-list DEFAULT_ROUTE
nv set router policy route-map WAN_IN rule 10 action permit
nv set router policy route-map WAN_IN rule 20 action deny

# Leftover from the earlier per-/24 policy - no longer referenced.
nv unset router policy prefix-list TENANT_SUBNETS 2>/dev/null || true

{% for u in wan_uplinks %}
# {{ u.description }}
nv set interface {{ u.interface }} description "{{ u.description }}"
nv set interface {{ u.interface }} link state up
nv set interface {{ u.interface }} link mtu {{ wan_mtu }}
nv set interface {{ u.interface }} ip address {{ u.local_ip }}
nv set interface {{ u.interface }} ip vrf {{ l3vni.vrf }}

nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} type numbered
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} remote-as {{ wan_pe_routers[u.pe].asn }}
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} description {{ u.pe }}
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} bfd enable on
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} address-family ipv4-unicast enable on
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} address-family ipv4-unicast policy inbound route-map WAN_IN
nv set vrf {{ l3vni.vrf }} router bgp neighbor {{ u.peer_ip }} address-family ipv4-unicast policy outbound route-map WAN_OUT

{% endfor %}
# Re-advertise the default route from the PEs into EVPN as type-5 with this
# border leaf's VTEP as next-hop, so every other leaf has two ECMP exits
# (one per border leaf). ECMP across PE1/PE2 here comes from the vrf
# multipath settings in the cumulus_overlay role.
nv set vrf {{ l3vni.vrf }} router bgp address-family ipv4-unicast route-export to-evpn enable on
