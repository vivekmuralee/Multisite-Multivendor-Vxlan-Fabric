! This file is managed by Ansible - do not edit by hand
frr defaults datacenter
hostname {{ inventory_hostname }}
log syslog informational
service integrated-vtysh-config
!
{% if 'spine' in group_names %}
{# ============================== SPINE =============================== #}
router bgp {{ router_asn }}
 bgp router-id {{ loopback_ip.split('/')[0] }}
 bgp bestpath as-path multipath-relax
 no bgp default ipv4-unicast
 neighbor UNDERLAY peer-group
 neighbor UNDERLAY remote-as external
 neighbor UNDERLAY capability extended-nexthop
 neighbor UNDERLAY bfd
{% for leaf_host in groups['leaf'] | sort %}
 neighbor swp{{ loop.index }} interface peer-group UNDERLAY
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ loopback_ip }}
  neighbor UNDERLAY activate
  maximum-paths {{ bgp_ecmp }}
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor UNDERLAY activate
  neighbor UNDERLAY attribute-unchanged next-hop
 exit-address-family
!
{% elif 'leaf' in group_names %}
{# =============================== LEAF ================================ #}
router bgp {{ router_asn }}
 bgp router-id {{ loopback_ip.split('/')[0] }}
 bgp bestpath as-path multipath-relax
 no bgp default ipv4-unicast
 neighbor UNDERLAY peer-group
 neighbor UNDERLAY remote-as external
 neighbor UNDERLAY capability extended-nexthop
 neighbor UNDERLAY bfd
{% for uplink in uplinks %}
 neighbor {{ uplink.interface }} interface peer-group UNDERLAY
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ loopback_ip }}
  neighbor UNDERLAY activate
  maximum-paths {{ bgp_ecmp }}
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor UNDERLAY activate
  advertise-all-vni
  advertise-default-gw
 exit-address-family
!
{% if l3vni is defined %}
{% set is_border = 'border_leaf' in group_names and external_bgp is defined and external_uplink is defined %}
router bgp {{ router_asn }} vrf {{ l3vni.vrf }}
 bgp router-id {{ loopback_ip.split('/')[0] }}
{% if is_border %}
 neighbor {{ external_uplink.peer_ip }} remote-as {{ external_bgp.peer_asn }}
 neighbor {{ external_uplink.peer_ip }} description EXTERNAL-WAN-MPLS-EDGE
{% endif %}
 !
 address-family ipv4 unicast
  redistribute connected
{% if is_border %}
  neighbor {{ external_uplink.peer_ip }} activate
  neighbor {{ external_uplink.peer_ip }} soft-reconfiguration inbound
  ! Only leak/accept tenant prefixes here - tighten with prefix-lists
  ! before using this in production.
{% endif %}
 exit-address-family
 !
 address-family l2vpn evpn
  advertise ipv4 unicast
 exit-address-family
!
{% endif %}
{% endif %}
