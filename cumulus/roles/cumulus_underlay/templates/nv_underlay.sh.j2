#!/bin/bash
# This script is generated by Ansible (cumulus_underlay role) - do not edit by hand.
# Stages the underlay/EVPN-transit BGP config as NVUE "nv set" commands; the
# task that runs this is followed by a separate "nv config apply" task, so
# nothing here takes effect until that commit happens.
set -e

nv set interface lo ip address {{ loopback_ip }}

{% if 'spine' in group_names %}
{% for leaf_host in groups['leaf'] | sort %}
nv set interface swp{{ loop.index }} link state up
nv set interface swp{{ loop.index }} link mtu {{ fabric_mtu }}
nv set vrf default router bgp neighbor swp{{ loop.index }} type unnumbered
nv set vrf default router bgp neighbor swp{{ loop.index }} peer-group UNDERLAY
{% endfor %}
{% elif 'leaf' in group_names %}
{% for uplink in uplinks %}
nv set interface {{ uplink.interface }} link state up
nv set interface {{ uplink.interface }} link mtu {{ fabric_mtu }}
nv set vrf default router bgp neighbor {{ uplink.interface }} type unnumbered
nv set vrf default router bgp neighbor {{ uplink.interface }} peer-group UNDERLAY
{% endfor %}
{% endif %}

nv set vrf default router bgp router-id {{ loopback_ip.split('/')[0] }}
nv set vrf default router bgp autonomous-system {{ router_asn }}

nv set vrf default router bgp peer-group UNDERLAY remote-as external
nv set vrf default router bgp peer-group UNDERLAY bfd enable on
nv set vrf default router bgp peer-group UNDERLAY address-family ipv4-unicast enable on
nv set vrf default router bgp peer-group UNDERLAY address-family l2vpn-evpn enable on

# Loopback advertised as a /32 host route, ECMP across all eBGP paths.
nv set vrf default router bgp address-family ipv4-unicast network {{ loopback_ip }}
nv set vrf default router bgp address-family ipv4-unicast multipaths ebgp {{ bgp_ecmp }}

# EVPN transit: spines relay these routes untouched (NVUE's default
# next-hop-setting "auto" is FRR's native L2VPN-EVPN behaviour - it does not
# rewrite next-hop for this AFI the way it does for ipv4-unicast - so this is
# the equivalent of the old frr.conf's explicit "attribute-unchanged next-hop").
nv set vrf default router bgp address-family l2vpn-evpn enable on

nv set vrf default router bgp enable on
