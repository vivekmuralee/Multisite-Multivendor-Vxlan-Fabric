#!/bin/bash
# This script is generated by Ansible (cumulus_overlay role) - do not edit by hand.
# Stages the VXLAN EVPN overlay - VNIs, distributed anycast gateway (VRR),
# and the tenant VRF - as NVUE "nv set" commands. A separate "nv config
# apply" task commits this.
set -e

nv set nve vxlan enable on
nv set nve vxlan source address {{ vtep_ip }}

{% for m in vni_mappings %}
# {{ m.name }} - VLAN {{ m.vlan }} / VNI {{ m.vni }} - distributed anycast gateway
nv set bridge domain br_default vlan {{ m.vlan }} vni {{ m.vni }}
nv set interface vlan{{ m.vlan }} type svi
nv set interface vlan{{ m.vlan }} vlan {{ m.vlan }}
nv set interface vlan{{ m.vlan }} ip vrf {{ l3vni.vrf }}
nv set interface vlan{{ m.vlan }} ip vrr enable on
nv set interface vlan{{ m.vlan }} ip vrr address {{ m.anycast_gw_ip }}
nv set interface vlan{{ m.vlan }} ip vrr mac-address {{ anycast_gw_mac }}
{% endfor %}

# L3 VNI - carries routed (symmetric IRB) traffic between tenant subnets.
# No VRR/anycast gateway here - this SVI just anchors the L3 VNI to the vrf.
nv set bridge domain br_default vlan {{ l3vni.vlan }} vni {{ l3vni.vni }}
nv set interface vlan{{ l3vni.vlan }} type svi
nv set interface vlan{{ l3vni.vlan }} vlan {{ l3vni.vlan }}
nv set interface vlan{{ l3vni.vlan }} ip vrf {{ l3vni.vrf }}

# Tenant VRF - redistributes connected subnets into EVPN type-5, and ties
# the L3 VNI to this vrf for symmetric IRB inter-subnet routing.
nv set vrf {{ l3vni.vrf }} router bgp enable on
nv set vrf {{ l3vni.vrf }} router bgp address-family ipv4-unicast enable on
nv set vrf {{ l3vni.vrf }} router bgp address-family ipv4-unicast redistribute connected enable on
nv set vrf {{ l3vni.vrf }} router bgp address-family l2vpn-evpn enable on
nv set vrf {{ l3vni.vrf }} evpn enable on
nv set vrf {{ l3vni.vrf }} evpn vlan {{ l3vni.vlan }}
nv set vrf {{ l3vni.vrf }} evpn vni {{ l3vni.vni }}
