! Generated by Ansible (arista_underlay role) - edit the vars, not the device.
interface Loopback0
   description BGP_ROUTER_ID
   ip address {{ router_id }}/32
!
{% if device_role != 'spine' %}
interface Loopback1
   description VTEP
   ip address {{ vtep_ip }}/32
!
{% endif %}
{% if device_role == 'spine' %}
{# Spine side of each link is built from the leaf's uplinks list #}
{% for leaf in groups['leaf'] %}
{% for u in hostvars[leaf].uplinks if u.peer == inventory_hostname %}
interface {{ u.peer_interface }}
   description {{ leaf }}
   mtu {{ fabric_mtu }}
   no switchport
   ip address {{ u.peer_ip }}/{{ p2p_prefixlen }}
!
{% endfor %}
{% endfor %}
{% else %}
{% for u in uplinks %}
interface {{ u.interface }}
   description {{ u.description | default(u.peer) }}
   mtu {{ fabric_mtu }}
   no switchport
   ip address {{ u.ip }}/{{ p2p_prefixlen }}
!
{% endfor %}
{% endif %}
router bgp {{ router_asn }}
   router-id {{ router_id }}
   no bgp default ipv4-unicast
   maximum-paths {{ bgp_ecmp }} ecmp {{ bgp_ecmp }}
   neighbor {{ evpn_peer_group }} peer group
{% if device_role != 'spine' %}
   neighbor {{ evpn_peer_group }} remote-as {{ spine_asn }}
{% endif %}
   neighbor {{ evpn_peer_group }} update-source Loopback0
   neighbor {{ evpn_peer_group }} ebgp-multihop 3
   neighbor {{ evpn_peer_group }} send-community extended
{% if device_role == 'spine' %}
   neighbor {{ evpn_peer_group }} next-hop-unchanged
{% endif %}
   neighbor {{ underlay_peer_group }} peer group
{% if device_role == 'spine' %}
{% for leaf in groups['leaf'] %}
{% for u in hostvars[leaf].uplinks if u.peer == inventory_hostname %}
   neighbor {{ u.ip }} peer group {{ underlay_peer_group }}
   neighbor {{ u.ip }} remote-as {{ hostvars[leaf].router_asn }}
{% endfor %}
{% endfor %}
{% for leaf in groups['leaf'] %}
   neighbor {{ hostvars[leaf].router_id }} peer group {{ evpn_peer_group }}
   neighbor {{ hostvars[leaf].router_id }} remote-as {{ hostvars[leaf].router_asn }}
{% endfor %}
{% else %}
   neighbor {{ underlay_peer_group }} remote-as {{ spine_asn }}
{% for u in uplinks %}
   neighbor {{ u.peer_ip }} peer group {{ underlay_peer_group }}
{% endfor %}
{% for spine in groups['spine'] %}
   neighbor {{ hostvars[spine].router_id }} peer group {{ evpn_peer_group }}
{% endfor %}
{% endif %}
   !
   address-family evpn
      neighbor {{ evpn_peer_group }} activate
   !
   address-family ipv4
      neighbor {{ underlay_peer_group }} activate
      network {{ router_id }}/32
{% if device_role != 'spine' %}
      network {{ vtep_ip }}/32
{% endif %}
