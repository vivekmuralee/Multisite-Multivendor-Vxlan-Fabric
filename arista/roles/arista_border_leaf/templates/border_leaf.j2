! Generated by Ansible (arista_border_leaf role) - edit the vars, not the device.
{% for w in wan_uplinks %}
interface {{ w.interface }}
   description {{ w.description }}
   mtu {{ wan_mtu }}
   no switchport
   vrf {{ l3vni.vrf }}
   ip address {{ w.local_ip }}
!
{% endfor %}
router bgp {{ router_asn }}
   vrf {{ l3vni.vrf }}
{% for w in wan_uplinks %}
      neighbor {{ w.peer_ip }} remote-as {{ w.peer_asn }}
      neighbor {{ w.peer_ip }} description {{ w.description }}
{% endfor %}
      !
      address-family ipv4
{% for w in wan_uplinks %}
         neighbor {{ w.peer_ip }} activate
{% endfor %}
