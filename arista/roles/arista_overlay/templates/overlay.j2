! Generated by Ansible (arista_overlay role) - edit the vars, not the device.
vrf instance {{ l3vni.vrf }}
!
ip routing vrf {{ l3vni.vrf }}
!
{% for m in vni_mappings %}
vlan {{ m.vlan }}
   name {{ m.name }}
!
{% endfor %}
{% for p in host_ports %}
interface {{ p.interface }}
   description {{ p.description }}
   switchport access vlan {{ p.vlan }}
   spanning-tree portfast edge
!
{% endfor %}
{% for m in vni_mappings %}
interface Vlan{{ m.vlan }}
   description {{ m.name }}_ANYCAST_GW
   vrf {{ l3vni.vrf }}
   ip address virtual {{ m.anycast_gw_ip }}
!
{% endfor %}
interface Vxlan1
   vxlan source-interface Loopback1
   vxlan udp-port 4789
{% for m in vni_mappings %}
   vxlan vlan {{ m.vlan }} vni {{ m.vni }}
{% endfor %}
   vxlan vrf {{ l3vni.vrf }} vni {{ l3vni.vni }}
!
ip virtual-router mac-address {{ anycast_gw_mac }}
!
router bgp {{ router_asn }}
   bgp bestpath as-path multipath-relax
{% for m in vni_mappings %}
   !
   vlan {{ m.vlan }}
      rd {{ router_id }}:{{ m.vni }}
      route-target both {{ m.vni }}:{{ m.vni }}
      redistribute learned
{% endfor %}
   !
   vrf {{ l3vni.vrf }}
      rd {{ router_id }}:{{ l3vni.vni }}
      route-target import evpn {{ l3vni.route_target }}
      route-target export evpn {{ l3vni.route_target }}
      maximum-paths {{ bgp_ecmp }} ecmp {{ bgp_ecmp }}
      redistribute connected
