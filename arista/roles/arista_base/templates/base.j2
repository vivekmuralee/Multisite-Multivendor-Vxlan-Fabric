! Generated by Ansible (arista_base role) - edit the vars, not the device.
hostname {{ inventory_hostname }}
!
spanning-tree mode mstp
!
clock timezone {{ timezone }}
!
vrf instance {{ mgmt_vrf }}
!
interface Management1
   vrf {{ mgmt_vrf }}
   ip address {{ ansible_host }}/{{ mgmt_prefixlen }}
!
ip routing
!
ip route vrf {{ mgmt_vrf }} 0.0.0.0/0 {{ mgmt_gateway }}
